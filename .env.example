# PostgreSQL connection settings used by scripts/db_access.py and scripts/load_prices.py.
# The code reads these from the environment; it does not load this file automatically.
# Export them in your shell, or leave PGUSER and PGPASSWORD unset to be prompted at run time
# (the password prompt is hidden). Never commit a file that contains a real password.
PGHOST=localhost
PGPORT=5432
PGDATABASE=idx_bank_risk
PGUSER=
PGPASSWORD=

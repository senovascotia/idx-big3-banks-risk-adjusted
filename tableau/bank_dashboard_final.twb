    </worksheet>
    <worksheet name='S9 Price vs total return'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#0b0b0b' fontname='Tableau Semibold' fontsize='11'>Cumulative return: price return against total return (banks only)</run>
            <run fontcolor='#52514e' fontsize='9'>
The IHSG has no dividend data, so it is not shown on the total-return basis</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='period_metrics' name='federated.metrics' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Zero' datatype='real' name='[Zero]' param-domain-type='any' role='measure' type='quantitative' value='0.0'>
              <calculation class='tableau' formula='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.metrics'>
            <column caption='Return basis' datatype='string' name='[basis]' role='dimension' type='nominal' />
            <column caption='Cumulative return' datatype='real' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[cum_return_pct]' role='measure' type='quantitative' />
            <column-instance column='[basis]' derivation='None' name='[none:basis:nk]' pivot='key' type='nominal' />
            <column-instance column='[cum_return_pct]' derivation='None' name='[none:cum_return_pct:qk]' pivot='key' type='quantitative' />
            <column-instance column='[period]' derivation='None' name='[none:period:nk]' pivot='key' type='nominal' />
            <column-instance column='[ticker]' derivation='None' name='[none:ticker:nk]' pivot='key' type='nominal' />
            <column caption='Period' datatype='string' name='[period]' role='dimension' type='nominal' />
            <column caption='Instrument' datatype='string' name='[ticker]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.metrics].[none:ticker:nk]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[none:ticker:nk]' member='&quot;BBCA&quot;' />
              <groupfilter function='member' level='[none:ticker:nk]' member='&quot;BBRI&quot;' />
              <groupfilter function='member' level='[none:ticker:nk]' member='&quot;BMRI&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.metrics].[none:ticker:nk]</column>
          </slices>
          <aggregation value='false' />
        </view>
        <style>
          <style-rule element='label'>
            <format attr='display' field='[federated.metrics].[none:ticker:nk]' value='false' />
          </style-rule>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.metrics].[none:ticker:nk]' type='palette'>
              <map to='#1baf7a'>
                <bucket>&quot;BMRI&quot;</bucket>
              </map>
              <map to='#2a78d6'>
                <bucket>&quot;BBCA&quot;</bucket>
              </map>
              <map to='#52514e'>
                <bucket>&quot;IHSG&quot;</bucket>
              </map>
              <map to='#eb6834'>
                <bucket>&quot;BBRI&quot;</bucket>
              </map>
            </encoding>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.metrics].[none:ticker:nk]' />
            </encodings>
            <reference-line axis-column='[federated.metrics].[none:cum_return_pct:qk]' enable-instant-analytics='false' formula='average' id='refline0' label-type='none' probability='95' scope='per-table' value-column='[Parameters].[Zero]' z-order='1' />
            <customized-tooltip>
              <formatted-text>
                <run fontname='Tableau Bold'><![CDATA[<[federated.metrics].[none:ticker:nk]>]]></run>
                <run fontcolor='#52514e'>, </run>
                <run fontname='Tableau Bold'><![CDATA[<[federated.metrics].[none:period:nk]>]]></run>
                <run fontcolor='#52514e'>, </run>
                <run fontname='Tableau Bold'><![CDATA[<[federated.metrics].[none:basis:nk]>]]></run>
                <run fontcolor='#52514e'>: </run>
                <run fontname='Tableau Bold'><![CDATA[<[federated.metrics].[none:cum_return_pct:qk]>]]></run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>([federated.metrics].[none:basis:nk] * [federated.metrics].[none:cum_return_pct:qk])</rows>
        <cols>([federated.metrics].[none:period:nk] / [federated.metrics].[none:ticker:nk])</cols>
      </table>
      <simple-id uuid='{CD16EE9A-6758-452E-A8FF-F46567788395}' />
    </worksheet>

            <encodings>
              <color column='[federated.capm].[none:ticker:nk]' />
              <size column='[federated.capm].[none:r2_ci_width:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontname='Tableau Bold'><![CDATA[<[federated.capm].[none:ticker:nk]>]]></run>
                <run fontcolor='#52514e'>, </run>
                <run fontname='Tableau Bold'><![CDATA[<[federated.capm].[none:period:nk]>]]></run>
                <run fontcolor='#52514e'>: R-squared </run>
                <run fontname='Tableau Bold'>&lt;[federated.capm].[none:r2:qk]&gt;</run>
                <run fontcolor='#52514e'> (</run>
                <run fontname='Tableau Bold'><![CDATA[<[federated.capm].[none:r2_ci_low:qk]>]]></run>
                <run fontcolor='#52514e'> to </run>
                <run fontname='Tableau Bold'><![CDATA[<[federated.capm].[none:r2_ci_high:qk]>]]></run>
                <run fontcolor='#52514e'>)</run>

            <reference-line axis-column='[federated.daily].[tdy:trade_date:qk]' enable-instant-analytics='true' formula='constant' id='refline0' label='R2' label-type='custom' scope='per-pane' value='#2022-08-23 00:00:00#' value-column='[federated.daily].[tdy:trade_date:qk]' z-order='2' />
            <reference-line axis-column='[federated.daily].[tdy:trade_date:qk]' enable-instant-analytics='true' formula='constant' id='refline1' label='R3' label-type='custom' scope='per-pane' value='#2024-09-18 00:00:00#' value-column='[federated.daily].[tdy:trade_date:qk]' z-order='3' />

    </action>
  </actions>
  <worksheets>
    <worksheet name='S1 Headline tiles'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#0b0b0b' fontname='Tableau Semibold' fontsize='11'>Full period, 4 Jan 2021 - 30 Sep 2026 (Sharpe minus IHSG: Ledoit-Wolf paired test)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='kpi' name='federated.kpi' />
          </datasources>
          <datasource-dependencies datasource='federated.kpi'>
            <column caption='Beta' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[beta]' role='measure' type='quantitative' />
            <column-instance column='[ticker]' derivation='None' name='[none:ticker:nk]' pivot='key' type='nominal' />
            <column caption='Price return 2021-26' datatype='real' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[price_return_pct]' role='measure' type='quantitative' />
            <column caption='R-squared' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[r2]' role='measure' type='quantitative' />
            <column caption='Sharpe ratio' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[sharpe]' role='measure' type='quantitative' />
            <column caption='p-value' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[sharpe_diff_p]' role='measure' type='quantitative' />
            <column caption='Sharpe minus IHSG' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[sharpe_diff_vs_ihsg]' role='measure' type='quantitative' />
            <column-instance column='[beta]' derivation='Sum' name='[sum:beta:qk]' pivot='key' type='quantitative' />
            <column-instance column='[price_return_pct]' derivation='Sum' name='[sum:price_return_pct:qk]' pivot='key' type='quantitative' />
            <column-instance column='[r2]' derivation='Sum' name='[sum:r2:qk]' pivot='key' type='quantitative' />
            <column-instance column='[sharpe]' derivation='Sum' name='[sum:sharpe:qk]' pivot='key' type='quantitative' />
            <column-instance column='[sharpe_diff_p]' derivation='Sum' name='[sum:sharpe_diff_p:qk]' pivot='key' type='quantitative' />
            <column-instance column='[sharpe_diff_vs_ihsg]' derivation='Sum' name='[sum:sharpe_diff_vs_ihsg:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_return_pct]' derivation='Sum' name='[sum:total_return_pct:qk]' pivot='key' type='quantitative' />
            <column caption='Instrument' datatype='string' name='[ticker]' role='dimension' type='nominal' />
            <column caption='Total return incl. dividends' datatype='real' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[total_return_pct]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.kpi].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.kpi].[sum:price_return_pct:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.kpi].[sum:total_return_pct:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.kpi].[sum:sharpe:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.kpi].[sum:sharpe_diff_vs_ihsg:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.kpi].[sum:sharpe_diff_p:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.kpi].[sum:beta:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.kpi].[sum:r2:qk]&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.kpi].[:Measure Names]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.kpi].[none:ticker:nk]' type='palette'>
              <map to='#1baf7a'>
                <bucket>&quot;BMRI&quot;</bucket>
              </map>
              <map to='#2a78d6'>
                <bucket>&quot;BBCA&quot;</bucket>
              </map>
              <map to='#52514e'>
                <bucket>&quot;IHSG&quot;</bucket>
              </map>
              <map to='#eb6834'>
                <bucket>&quot;BBRI&quot;</bucket>
              </map>
            </encoding>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.kpi].[Multiple Values]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.kpi].[none:ticker:nk]</rows>
        <cols>[federated.kpi].[:Measure Names]</cols>
      </table>
      <simple-id uuid='{D56AA0C7-02D2-4D5F-B102-7680FF6FBF41}' />
    </worksheet>
    <worksheet name='S10 Regimes'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#0b0b0b' fontname='Tableau Semibold' fontsize='11'>Regimes (fixed in advance by policy-rate phase)</run>
            <run fontcolor='#52514e' fontsize='9'>&#10;Return days in each regime</run>
